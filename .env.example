# Nebius Token Factory API Key (OpenAI-compatible)
# Get your key from: https://tokenfactory.nebius.com/
NEBIUS_API_KEY=your_nebius_api_key_here

# Model to use (default: nvidia/nemotron-3-super-120b-a12b)
# Other options available from Nebius Token Factory
NEMOTRON_MODEL=nvidia/nemotron-3-super-120b-a12b

# Optional: Custom database path
# HABITLOOP_DB=habitloop.db
